---
const navLinks = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Sobre Mí', href: '#sobre-mi' },
  { label: 'Formación', href: '#formacion' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header class="fixed inset-x-0 top-4 z-50 flex justify-center">
  <nav
    class="flex items-center justify-between gap-6 px-5 py-3 shadow-[--shadow-md] transition-all duration-[--transition-base] md:gap-10 md:px-8 md:py-3.5"
    style="
      border-radius: var(--radius-full);
      background-color: rgba(244, 237, 229, 0.9);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      max-width: 90vw;
    "
  >
    <!-- Logo -->
    <a
      href="#inicio"
      class="flex shrink-0 items-center gap-2 no-underline"
    >
      <img
        src="/images/logos/4.png"
        alt=""
        width="36"
        height="36"
        class="h-8 w-8 md:h-9 md:w-9"
      />
      <span
        class="text-[1rem] tracking-tight md:text-[1.125rem]"
        style="
          font-family: var(--font-heading);
          font-weight: var(--font-weight-semibold);
          color: var(--color-primary-dark);
        "
      >
        Itzayanha Rico
      </span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-6 list-none m-0 p-0">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="relative whitespace-nowrap text-[0.8125rem] tracking-wide no-underline transition-colors duration-[--transition-fast]"
              style="
                font-weight: var(--font-weight-medium);
                color: var(--color-text-muted);
              "
            >
              {link.label}
              <span
                class="nav-underline absolute -bottom-1 left-0 h-[2px] w-full origin-left scale-x-0 rounded-full transition-transform duration-[--transition-base]"
                style="background-color: var(--color-primary);"
              >
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile hamburger -->
    <details class="group md:hidden">
      <summary class="flex list-none cursor-pointer items-center p-1" style="color: var(--color-text);">
        <svg
          class="group-open:hidden"
          width="22" height="22" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round"
          aria-label="Abrir menú"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg
          class="hidden group-open:block"
          width="22" height="22" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round"
          aria-label="Cerrar menú"
        >
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </summary>

      <ul
        class="absolute right-0 top-full mt-3 w-48 list-none m-0 rounded-2xl p-4 space-y-3 shadow-[--shadow-lg]"
        style="background-color: var(--color-bg);"
      >
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block text-[0.8125rem] tracking-wide no-underline transition-colors duration-[--transition-fast]"
                style="
                  color: var(--color-text-muted);
                  font-weight: var(--font-weight-medium);
                "
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>

<style>
  a:hover {
    color: var(--color-primary) !important;
  }

  a:hover .nav-underline {
    transform: scaleX(1);
  }

  details summary::-webkit-details-marker {
    display: none;
  }
</style>
