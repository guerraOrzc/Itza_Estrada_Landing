---
interface Props {
  topColor: string;
  bottomColor: string;
  height?: string;
}

const { topColor, bottomColor, height = 'clamp(56px, 8vw, 110px)' } = Astro.props;
---

<div
  class="wave-seam"
  style={`--top-color: ${topColor}; --bottom-color: ${bottomColor}; --seam-height: ${height};`}
  aria-hidden="true"
>
  <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
    <path class="seam-top" d="M0,0 L1440,0 L1440,45 C1200,10 960,80 720,45 C480,10 240,90 0,45 Z" />
    <path class="seam-bottom" d="M0,45 C240,90 480,10 720,45 C960,80 1200,10 1440,45 L1440,100 L0,100 Z" />
  </svg>
</div>

<style>
  .wave-seam {
    width: 100%;
    height: var(--seam-height);
    line-height: 0;
  }

  .wave-seam svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .seam-top {
    fill: var(--top-color);
  }

  .seam-bottom {
    fill: var(--bottom-color);
  }
</style>
