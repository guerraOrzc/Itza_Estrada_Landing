---
import { getCollection } from 'astro:content';
import EducationCard from './EducationCard.astro';

const certs = await getCollection('certifications');
const sorted = certs.sort((a, b) => a.data.order - b.data.order);
---

<section
  id="formacion"
  style="padding: var(--section-padding-y) var(--section-padding-x); background-color: var(--color-secondary);"
>
  <div class="mx-auto" style="max-width: var(--container-max-width);">
    <div class="mb-16 text-center">
      <h2
        class="m-0"
        style="
          font-family: var(--font-heading);
          font-size: var(--font-size-4xl);
          font-weight: var(--font-weight-bold);
          color: var(--color-text);
        "
      >
        Formación y Certificaciones
      </h2>
      <div
        class="mx-auto mt-4 h-1 w-16 rounded-full"
        style="background-color: var(--color-primary);"
      ></div>
      <p
        class="mx-auto mt-4 max-w-xl"
        style="
          color: var(--color-text-muted-strong);
          font-size: var(--font-size-lg);
          line-height: var(--line-height-relaxed);
        "
      >
        Preparación continua para ofrecerte un tratamiento actualizado. Toca
        cualquier etapa para ver los detalles.
      </p>
    </div>

    <div class="relative mx-auto max-w-4xl">
      <!-- Vertical timeline line -->
      <div
        class="absolute left-[19px] top-2 h-full w-0.5 md:left-1/2 md:-translate-x-px"
        style="background: linear-gradient(to bottom, var(--color-primary), var(--color-primary-light));"
        aria-hidden="true"
      ></div>

      <div class="flex flex-col">
        {
          sorted.map((cert, i) => {
            const isEven = i % 2 === 0;
            return (
              <div class={`edu-row relative flex pb-12 last:pb-0 md:pb-16 ${isEven ? 'md:flex-row-reverse' : 'md:flex-row'}`}>
                {/* Timeline dot: fills in while its card is expanded */}
                <div
                  class="edu-dot absolute left-[12px] top-2 z-10 h-4 w-4 rounded-full border-[3px] md:left-1/2 md:-translate-x-1/2"
                  aria-hidden="true"
                />

                {/* Spacer for timeline center alignment on desktop */}
                <div class="hidden w-1/2 md:block" aria-hidden="true" />

                <div class={`pl-12 md:w-1/2 md:pl-0 ${isEven ? 'md:pr-10 md:text-right' : 'md:pl-10 md:text-left'}`}>
                  <time
                    class="mb-1 inline-block font-semibold tracking-wide"
                    style="
                      color: var(--color-primary);
                      font-size: var(--font-size-sm);
                      font-family: var(--font-body);
                    "
                  >
                    {cert.data.year}
                  </time>

                  <EducationCard
                    id={cert.id}
                    title={cert.data.title}
                    institution={cert.data.institution}
                    description={cert.data.description}
                    topics={cert.data.topics}
                    image={cert.data.image}
                    certificate={cert.data.certificate}
                    align={isEven ? 'end' : 'start'}
                  />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .edu-dot {
    background-color: var(--color-secondary);
    border-color: var(--color-primary);
    transition:
      background-color var(--transition-base) var(--ease-out),
      box-shadow var(--transition-base) var(--ease-out);
  }

  .edu-row[data-open='true'] .edu-dot {
    background-color: var(--color-primary);
    box-shadow: 0 0 0 6px rgba(114, 145, 147, 0.25);
  }
</style>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('#formacion .edu-card')];

  function setOpen(card: HTMLElement, open: boolean) {
    card.dataset.open = String(open);
    card.closest<HTMLElement>('.edu-row')?.setAttribute('data-open', String(open));
    card.querySelector('.edu-toggle')?.setAttribute('aria-expanded', String(open));
    card.querySelector('.edu-panel')?.toggleAttribute('inert', !open);
  }

  for (const card of cards) {
    const toggle = card.querySelector<HTMLButtonElement>('.edu-toggle');
    toggle?.addEventListener('click', () => setOpen(card, card.dataset.open !== 'true'));
    card.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || card.dataset.open !== 'true') return;
      setOpen(card, false);
      toggle?.focus();
    });
  }
</script>
