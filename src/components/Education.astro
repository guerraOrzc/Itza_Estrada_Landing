---
import { getCollection } from 'astro:content';

const certs = await getCollection('certifications');
const sorted = certs.sort((a, b) => a.data.order - b.data.order);
---

<section
  id="formacion"
  style="padding: var(--section-padding-y) var(--section-padding-x);"
>
  <div class="mx-auto" style="max-width: var(--container-max-width);">
    <div class="mb-12 text-center">
      <h2
        class="m-0"
        style="
          font-family: var(--font-heading);
          font-size: var(--font-size-4xl);
          font-weight: var(--font-weight-bold);
          color: var(--color-text);
        "
      >
        Formación y Certificaciones
      </h2>
      <div
        class="mx-auto mt-4 h-1 w-16 rounded-full"
        style="background-color: var(--color-accent);"
      ></div>
    </div>

    <div class="mx-auto max-w-3xl space-y-5">
      {
        sorted.map((cert) => (
          <article
            class="group flex flex-col gap-1 rounded-[--radius-md] border-l-4 p-6 transition-shadow duration-[--transition-base] hover:shadow-[--shadow-md]"
            style="
              border-color: var(--color-primary);
              background-color: var(--color-bg);
              box-shadow: var(--shadow-sm);
            "
          >
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3
                class="m-0"
                style="
                  font-family: var(--font-heading);
                  font-size: var(--font-size-xl);
                  font-weight: var(--font-weight-semibold);
                  color: var(--color-text);
                "
              >
                {cert.data.title}
              </h3>

              <span
                class="shrink-0 rounded-[--radius-full] px-3 py-0.5"
                style="
                  background-color: var(--color-accent-light);
                  color: var(--color-accent);
                  font-size: var(--font-size-sm);
                  font-weight: var(--font-weight-semibold);
                "
              >
                {cert.data.year}
              </span>
            </div>

            <p
              class="m-0"
              style="
                color: var(--color-text-muted);
                font-size: var(--font-size-base);
                font-weight: var(--font-weight-medium);
              "
            >
              {cert.data.institution}
            </p>

            {
              cert.data.description && (
                <p
                  class="m-0 mt-2"
                  style="
                    color: var(--color-text-muted);
                    font-size: var(--font-size-sm);
                    line-height: var(--line-height-relaxed);
                  "
                >
                  {cert.data.description}
                </p>
              )
            }
          </article>
        ))
      }
    </div>
  </div>
</section>
