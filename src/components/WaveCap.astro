---
interface Props {
  color: string;
  position: 'top' | 'bottom';
  height?: string;
  overlap?: boolean;
}

const { color, position, height = 'clamp(56px, 8vw, 110px)', overlap = false } = Astro.props;
---

<div
  class={`wave-cap wave-cap-${position} ${overlap ? 'wave-cap-overlap' : ''}`}
  style={`--wave-color: ${color}; --wave-height: ${height};`}
  aria-hidden="true"
>
  <svg viewBox="0 0 1440 100" preserveAspectRatio="none">
    <path d="M0,45 C240,90 480,10 720,45 C960,80 1200,10 1440,45 L1440,100 L0,100 Z" />
  </svg>
</div>

<style>
  .wave-cap {
    width: 100%;
    height: var(--wave-height);
    line-height: 0;
  }

  .wave-cap svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wave-cap path {
    fill: var(--wave-color);
  }

  .wave-cap-bottom svg {
    transform: scaleY(-1);
  }

  /* Pulls the cap up so it overlaps and paints over the end of the
     preceding element (e.g. the hero video) instead of leaving a gap. */
  .wave-cap-overlap {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * var(--wave-height));
  }
</style>
