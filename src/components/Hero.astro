<section
  id="inicio"
  class="relative flex items-center overflow-hidden"
  style="min-height: calc(100vh - var(--navbar-height)); padding-top: calc(var(--navbar-height) + 1rem);"
>
  <!-- Background video -->
  <video
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    poster="/images/hero-poster.jpg"
  >
    <source src="/videos/hero-background.mp4" type="video/mp4" />
  </video>

  <!-- Dark overlay for text contrast -->
  <div
    class="absolute inset-0"
    style="background: linear-gradient(180deg, rgba(20, 20, 20, 0.55) 0%, rgba(20, 20, 20, 0.7) 100%);"
  ></div>

  <div
    class="relative mx-auto w-full max-w-[--container-max-width] px-[--section-padding-x]"
  >
    <!-- Text -->
    <div class="animate-fade-in flex max-w-xl flex-col gap-6">
      <span
        class="inline-block w-fit rounded-full px-4 py-1.5 text-[--font-size-xs] tracking-wider uppercase"
        style="
          background-color: var(--color-primary-light);
          color: var(--color-primary-dark);
          font-weight: var(--font-weight-semibold);
        "
      >
        Fisioterapeuta profesional
      </span>

      <h1
        class="m-0 leading-[1.15]"
        style="
          font-family: var(--font-heading);
          font-size: clamp(2rem, 5vw, 3.5rem);
          font-weight: var(--font-weight-bold);
          color: #ffffff;
        "
      >
        Fisioterapia que transforma vidas
      </h1>

      <p
        class="m-0 max-w-md"
        style="
          font-size: var(--font-size-lg);
          color: rgba(255, 255, 255, 0.85);
          line-height: var(--line-height-relaxed);
        "
      >
        Atención personalizada basada en evidencia científica para ayudarte a
        recuperar tu movilidad, aliviar el dolor y mejorar tu calidad de vida.
      </p>

      <div class="flex flex-wrap gap-4 pt-2">
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-[--radius-full] px-8 py-3.5 no-underline transition-all duration-[--transition-base] hover:-translate-y-0.5"
          style="
            background-color: var(--color-primary);
            color: var(--color-text-inverse);
            font-weight: var(--font-weight-semibold);
            font-size: var(--font-size-base);
            box-shadow: var(--shadow-md);
          "
        >
          Agenda tu cita
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>

        <a
          href="#servicios"
          class="inline-flex items-center rounded-[--radius-full] border-2 px-8 py-3.5 no-underline transition-all duration-[--transition-base] hover:-translate-y-0.5"
          style="
            border-color: #ffffff;
            color: #ffffff;
            font-weight: var(--font-weight-semibold);
            font-size: var(--font-size-base);
          "
        >
          Conoce mis servicios
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeInUp 0.8s var(--ease-out) both;
  }

  .animate-delay-200 {
    animation-delay: 200ms;
  }
</style>
