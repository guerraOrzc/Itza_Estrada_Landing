<section
  id="inicio"
  class="relative flex items-center overflow-hidden"
  style="min-height: calc(100vh - var(--navbar-height)); padding-top: calc(var(--navbar-height) + 1rem);"
>
  <!-- Background decoration -->
  <div
    class="absolute -top-40 -right-40 h-[500px] w-[500px] rounded-full opacity-20"
    style="background: var(--color-primary-light);"
  ></div>
  <div
    class="absolute -bottom-20 -left-20 h-[300px] w-[300px] rounded-full opacity-15"
    style="background: var(--color-accent-light);"
  ></div>

  <div
    class="relative mx-auto grid w-full max-w-[--container-max-width] items-center gap-12 px-[--section-padding-x] md:grid-cols-2"
  >
    <!-- Left: text -->
    <div class="animate-fade-in flex flex-col gap-6">
      <span
        class="inline-block rounded-full px-4 py-1.5 text-[--font-size-xs] tracking-wider uppercase"
        style="
          background-color: var(--color-primary-light);
          color: var(--color-primary-dark);
          font-weight: var(--font-weight-semibold);
        "
      >
        Fisioterapeuta profesional
      </span>

      <h1
        class="m-0 leading-[1.15]"
        style="
          font-family: var(--font-heading);
          font-size: clamp(2rem, 5vw, 3.5rem);
          font-weight: var(--font-weight-bold);
          color: var(--color-text);
        "
      >
        Fisioterapia que transforma vidas
      </h1>

      <p
        class="m-0 max-w-md"
        style="
          font-size: var(--font-size-lg);
          color: var(--color-text-muted);
          line-height: var(--line-height-relaxed);
        "
      >
        Atención personalizada basada en evidencia científica para ayudarte a
        recuperar tu movilidad, aliviar el dolor y mejorar tu calidad de vida.
      </p>

      <div class="flex flex-wrap gap-4 pt-2">
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 rounded-[--radius-full] px-8 py-3.5 no-underline transition-all duration-[--transition-base] hover:-translate-y-0.5"
          style="
            background-color: var(--color-primary);
            color: var(--color-text-inverse);
            font-weight: var(--font-weight-semibold);
            font-size: var(--font-size-base);
            box-shadow: var(--shadow-md);
          "
        >
          Agenda tu cita
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>

        <a
          href="#servicios"
          class="inline-flex items-center rounded-[--radius-full] border-2 px-8 py-3.5 no-underline transition-all duration-[--transition-base] hover:-translate-y-0.5"
          style="
            border-color: var(--color-primary);
            color: var(--color-primary);
            font-weight: var(--font-weight-semibold);
            font-size: var(--font-size-base);
          "
        >
          Conoce mis servicios
        </a>
      </div>
    </div>

    <!-- Right: placeholder image -->
    <div class="animate-fade-in animate-delay-200 hidden md:flex items-center justify-center">
      <div
        class="relative flex h-80 w-80 items-center justify-center rounded-[--radius-lg] lg:h-96 lg:w-96"
        style="
          background: linear-gradient(135deg, var(--color-primary-light), var(--color-accent-light));
          box-shadow: var(--shadow-lg);
        "
      >
        <!-- Physiotherapy SVG icon placeholder -->
        <svg
          class="h-28 w-28 lg:h-36 lg:w-36"
          viewBox="0 0 120 120"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          style="color: var(--color-primary);"
        >
          <!-- Stylised human figure -->
          <circle cx="60" cy="26" r="12" stroke="currentColor" stroke-width="2.5" fill="none" opacity="0.7" />
          <line x1="60" y1="38" x2="60" y2="72" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.7" />
          <line x1="60" y1="72" x2="38" y2="98" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.7" />
          <line x1="60" y1="72" x2="82" y2="98" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.7" />
          <line x1="60" y1="48" x2="30" y2="60" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.7" />
          <line x1="60" y1="48" x2="90" y2="60" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" opacity="0.7" />
          <!-- Heart/hands symbolising care -->
          <path d="M56 80 Q53 74 56 70 Q60 66 60 66 Q60 66 64 70 Q67 74 64 80 L60 86 Z"
                stroke="var(--color-accent)" stroke-width="2" fill="var(--color-accent)" opacity="0.8" />
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeInUp 0.8s var(--ease-out) both;
  }

  .animate-delay-200 {
    animation-delay: 200ms;
  }
</style>
